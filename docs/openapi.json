  "components": {
    "schemas": {
      "AlertCreate": {
        "properties": {
          "emergency_type": {
            "$ref": "#/components/schemas/EmergencyType",
            "description": "Predefined emergency type",
            "example": "Medical Emergency"
          },
          "building_id": {
            "type": "integer",
            "title": "Building Id",
            "description": "ID of campus building",
            "example": 1
          },
          "room_number": {
            "type": "string",
            "title": "Room Number",
            "description": "Room identifier",
            "example": "LAB-1"
          },
          "floor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor",
            "description": "Building floor (ground=0, 1, 2...)",
            "example": 1
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional brief context",
            "example": "Student collapsed near workbench"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude",
            "description": "Optional GPS latitude",
            "example": 12.9716
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude",
            "description": "Optional GPS longitude",
            "example": 77.5946
          }
        },
        "type": "object",
        "required": [
          "emergency_type",
          "building_id",
          "room_number"
        ],
        "title": "AlertCreate"
      },
      "AlertPriority": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW"
        ],
        "title": "AlertPriority"
      },
      "AlertResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "alert_code": {
            "type": "string",
            "title": "Alert Code"
          },
          "student_id": {
            "type": "integer",
            "title": "Student Id"
          },
          "student_roll_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Roll Number"
          },
          "student_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Name"
          },
          "student_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Phone"
          },
          "emergency_type": {
            "$ref": "#/components/schemas/EmergencyType"
          },
          "priority": {
            "$ref": "#/components/schemas/AlertPriority"
          },
          "status": {
            "$ref": "#/components/schemas/AlertStatus"
          },
          "building_id": {
            "type": "integer",
            "title": "Building Id"
          },
          "building_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building Name"
          },
          "building_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building Code"
          },
          "room_number": {
            "type": "string",
            "title": "Room Number"
          },
